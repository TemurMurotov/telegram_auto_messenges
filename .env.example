# my.telegram.org -> API development tools -> shu yerdan olasiz
API_ID=1234567
API_HASH=your_api_hash_here

# O'z telefon raqamingiz (xalqaro formatda), masalan: +998901234567
PHONE=+998901234567

# Kimga xabar yuborilsin: @username yoki telefon raqam yoki user id
TARGET=@sevganim

# Har kuni yuboriladigan xabar matni
MESSAGE=Xayrli tun, seni o'ylab turibman ❤️

# Yuboriladigan rasm (ixtiyoriy). MESSAGE matni rasm tagida chiqadi.
# Loyiha papkasiga nisbatan yoki to'liq yo'l: photo.jpg yoki /home/user/Pictures/photo.jpg
# Bo'sh qoldirilsa — faqat matn yuboriladi.
IMAGE=photo.jpg

# Yuborish vaqti (mahalliy vaqt, 24 soatlik format HH:MM)
SEND_TIME=01:00

# O'qilmasa o'chirish vaqti (HH:MM)
CLEANUP_TIME=05:00

# Vaqt mintaqasi (masalan: Asia/Tashkent)
TIMEZONE=Asia/Tashkent

# O'qilganda desktop bildirishnoma chiqsinmi? (notify-send kerak) true/false
DESKTOP_NOTIFY=true
